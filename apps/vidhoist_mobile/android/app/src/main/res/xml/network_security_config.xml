<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this phone itself: the player reaches the computer
     link's proxy at 127.0.0.1, which fetches over the pinned TLS link
     (PcStreamProxy). Every other address keeps Android's default, which
     refuses plain HTTP. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
