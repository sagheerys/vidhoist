<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's automatic backup, Android 11 and below: `fullBackupContent`.

  Backup is on by default, so Google copies the app's files to the user's
  account unless told otherwise. Three things stay behind:

  * `FlutterSecureStorage.xml`: encrypted with a key that lives in this
    device's Keystore and does not travel, so on a new phone the file
    arrives without its key and reading a secret throws instead of
    returning nothing.
  * `cookies.txt` and the WebView's own store (`app_webview/`): the
    sign-ins to sites. They stay on this phone, where yt-dlp reads them,
    and are sent nowhere else, a cloud backup included.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="file" path="cookies.txt"/>
    <exclude domain="root" path="app_webview/"/>
</full-backup-content>
