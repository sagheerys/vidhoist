# ===== Flutter / Dart =====
devtools_options.yaml
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
coverage/
*.lock.json

# The vendored plugins resolve through the workspace lock, not their own.
third_party/*/pubspec.lock

# ===== Android =====
**/android/.gradle/
# Kotlin compiler leftovers (sessions and errors) from recent AGP.
**/android/.kotlin/
**/android/local.properties
**/android/key.properties
captures/

# ===== Build outputs: never in the repository =====
# A built app or a downloaded clip makes every clone heavier for good.
*.apk
*.aab
*.zip
*.mp4
*.vidhoist_backup*.json
vidhoist_*_backup.json

# yt-dlp fetched by tool/fetch-engine.ps1 for the installer.
apps/vidhoist_desktop/tools/

# ===== Secrets =====
.env
.env.*
*.secret
*.keystore
*.jks
keys/
# A backup's passphrase beside the backup gives the data away.
*_backup_key.txt
*.private.*
private/

# ===== IDE / OS =====
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs and temporaries =====
*.log
logs/
tmp/
__pycache__/

# ===== The root =====
# It publishes only the documents listed here, so a working note left there
# never becomes part of the repository. Add `!/<NAME>.md` to publish one.
/*.md
!/README.md
!/README.ar.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
/*.html
/*.txt
/*.pdf
/*.docx
/*.xlsx
