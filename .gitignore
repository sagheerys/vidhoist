# ===== Flutter / Dart =====
devtools_options.yaml
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
coverage/
*.lock.json

# ===== Android =====
**/android/.gradle/
# Kotlin compiler leftovers (sessions and errors), produced by the built-in
# Kotlin support in recent AGP.
**/android/.kotlin/
**/android/local.properties
**/android/key.properties
*.keystore
*.jks
captures/

# ===== Build outputs — never in the repository =====
# Lesson from the previous generation of this project: a 62MB APK and video
# files had been committed into git.
*.apk
*.aab
*.zip
*.mp4
*.vidhoist_backup*.json
vidhoist_*_backup.json

# ===== Secrets =====
.env
.env.*
*.secret

# ===== IDE / OS =====
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ===== Logs and temporaries =====
*.log
logs/
tmp/

# Signing keys — never in git. Copies live on the two backup drives.
keys/

# Backup passphrases: the key next to the backup means the data is exposed.
*_backup_key.txt

# ===== Agent tooling — local to the maintainer's machine =====
# Third-party skill content (sources and hashes recorded in skills-lock.json)
# is not republished from here; restore it from its own sources when needed.
.claude/
.agents/
skills-lock.json

# ── Local-only ──
# The assistant's instructions and the machine's notes (paths, workarounds)
# stay on the maintainer's disk: they are not useful to anyone cloning, and
# some carry local paths.
CLAUDE.md
CLAUDE.local.md
# Every PowerShell script under tool/ is the maintainer's own: they carry
# local drive paths and are useless to anyone cloning. Listing them one by one
# let a new one (tool/downloads.ps1, 2026-09-16) reach the public repo before
# anybody noticed, so the rule is the extension now. Add `!tool/<name>.ps1`
# below if one is ever meant to be published.
tool/*.ps1
# Published: no local path, and the installer's test reads its pins.
!tool/fetch-engine.ps1
tool/*.cmd
tool/build-lite.log
# The screenshot kit (mock server, generated demo media, emulator driver):
# local paths again, and nothing anyone cloning can run as it stands.
tool/demo-kit/
tool/cmdtools-url.txt
tool/flutter-url.txt
.design/
docs/reports/
docs/proposals/
docs/TEST-MATRIX.md

# The plans, the reports and the mockups drawn before a screen is coded:
# an internal record. What a contributor needs from them is in docs/
# (ENGINE.md, PC-LINK.md, ARCHITECTURE.md, adr/). The shipped icons are
# generated by tool/icons/vidhoist_kit.py.
docs/plan/
docs/blueprint/
docs/design/
# The record of where the code came from: VidHoist is its own project.
docs/adr/0001-fork-from-vidhoist-mobile.md

# The vendored plugin resolves through the workspace lock, not its own.
third_party/*/pubspec.lock

# Transcripts backfill tool: answers kept between runs, and its import file
.mtf-transcripts/
mtf-transcripts-library*.json

# Python bytecode from the tool scripts
__pycache__/

# Pages saved while investigating (a YouTube watch page, 2026-10-28) are
# never source; the repository root holds no HTML of its own.
/*.html

# yt-dlp fetched by tool/fetch-engine.ps1 for the installer.
apps/vidhoist_desktop/tools/

# Research scratch (deep-research skill), not part of the app
/research_notes/
/reports/

# The root publishes only the documents listed here, so a stray working note
# never becomes part of the repository. Add `!/<NAME>.md` to publish a new
# one; private notes belong in docs/reports/, which is ignored above.
/*.md
!/README.md
!/README.ar.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
/*.txt
/*.pdf
/*.docx
/*.xlsx
*.private.*
private/
